# Copy to .env and edit before docker compose up
# cp .env.example .env

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Tehran

# Comma-separated origins for CSRF (https required in production)
CSRF_TRUSTED_ORIGINS=https://api.example.com,https://example.com

# Redis (service name inside docker network)
REDIS_URL=redis://redis:6379/0
REDIS_OPTIONAL=true

# Host port for nginx
HTTP_PORT=80
